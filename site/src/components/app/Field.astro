---
// 通用表单字段。name 使用"分组.字段"的写法（例如 entity.legalName），脚本据此读写数据。
interface Opt { value: string; label: string }
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'date' | 'textarea' | 'select' | 'checkboxes' | 'radios';
  required?: boolean;
  hint?: string;
  options?: Opt[];
  /** 选项中含 other 时，显示"请注明"输入框 */
  otherLabel?: string;
  span?: boolean;
  optionalLabel?: string;
  selectLabel?: string;
  autocomplete?: string;
  maxlength?: number;
}
const { name, label, type = 'text', required = false, hint, options = [], otherLabel, span, optionalLabel, selectLabel, autocomplete, maxlength = 300 } = Astro.props;
const id = 'f-' + name.replace(/[^a-zA-Z0-9]/g, '-');
const hasOther = options.some((x) => x.value === 'other');
---
<div class={`f ${span ? 'span-all' : ''}`} data-field={name} data-type={type} data-required={required ? '1' : undefined}>
  {type === 'checkboxes' || type === 'radios' ? (
    <span class="lbl" id={`${id}-l`}>{label}{required ? <span class="req" aria-hidden="true">*</span> : optionalLabel && <span class="opt"> ({optionalLabel})</span>}</span>
  ) : (
    <label for={id}>{label}{required ? <span class="req" aria-hidden="true">*</span> : optionalLabel && <span class="opt"> ({optionalLabel})</span>}</label>
  )}
  {hint && <p class="hint">{hint}</p>}
  {type === 'textarea' && <textarea id={id} name={name} required={required} maxlength={2000} rows={3}></textarea>}
  {type === 'select' && (
    <select id={id} name={name} required={required}>
      <option value="">{selectLabel}</option>
      {options.map((x) => <option value={x.value}>{x.label}</option>)}
    </select>
  )}
  {(type === 'checkboxes' || type === 'radios') && (
    <div class="choices" role="group" aria-labelledby={`${id}-l`}>
      {options.map((x) => (
        <label><input type={type === 'checkboxes' ? 'checkbox' : 'radio'} name={name} value={x.value} />{x.label}</label>
      ))}
    </div>
  )}
  {['text', 'email', 'tel', 'date'].includes(type) && (
    <input id={id} name={name} type={type} required={required} autocomplete={autocomplete || 'off'} maxlength={type === 'date' ? undefined : maxlength} />
  )}
  {hasOther && otherLabel && (
    <input class="other-input" name={`${name}Other`} type="text" placeholder={otherLabel} aria-label={`${label} - ${otherLabel}`} maxlength={200} hidden data-other-for={name} />
  )}
  <p class="err" data-err-for={name}></p>
</div>
