---
import { t, href, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="cta-band">
  <div class="container inner">
    <div>
      <h2>{d.cta.title}</h2>
      <p>{d.cta.body}</p>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href={href(lang, 'contact')} data-cta>{d.cta.button}</a>
    </div>
  </div>
</section>
<style>
  .cta-band { background: linear-gradient(135deg, #0b1f3a 0%, #0f3a4f 100%); color: #fff; padding: 64px 0; }
  .inner { display: flex; gap: 32px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .inner p { color: #c3cfdd; max-width: 620px; margin: 0; }
  .btn-primary { background: var(--emerald); color: #062017; }
  .btn-primary:hover { background: #3fd4a6; }
</style>
