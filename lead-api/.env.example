# Vercel 项目需要配置的环境变量（Project → Settings → Environment Variables）。
# 本文件只是清单，不要把真实值提交到仓库。

# 存储与限流（D1：Upstash Redis）。通过 Vercel 市场集成开通后会自动注入，不需要手填。
# 预览环境和生产环境必须连接不同的数据库。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 限流（可选，默认同一 IP 10 分钟 5 次）
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# 邮件（D2）：二选一
# 方式 A：Resend（填写后优先使用）
RESEND_API_KEY=
# 方式 B：SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

MAIL_FROM="Quick Come Website <no-reply@quickcomepay.com>"
MAIL_TO=sales@quickcomepay.com
