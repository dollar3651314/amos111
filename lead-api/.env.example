# lead-api 环境变量模板。生产环境放在 /etc/quickcome/lead-api.env，权限 600。
PORT=3001
HOST=127.0.0.1
DATA_DIR=/var/lib/quickcome
# 在 Nginx 后面运行时设为 1，从 X-Real-IP 读取访客 IP
TRUST_PROXY=1
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# 使用 465 端口（SMTPS）时设为 1
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Quick Come Website <no-reply@quickcomepay.com>"
MAIL_TO=sales@quickcomepay.com
